# --- Walrus Memory (https://memory.walrus.xyz -> create account + delegate key) ---
# Delegate private key (hex, ed25519). Server-side only, never NEXT_PUBLIC_*.
MEMWAL_PRIVATE_KEY=
# MemWalAccount object ID on Sui (0x...)
MEMWAL_ACCOUNT_ID=
# Relayer URL. Mainnet (default) / staging testnet:
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# mainnet | testnet — controls the "anchored to ..." toast copy
MEMWAL_NETWORK=mainnet
# Minimum relevance (0-1, score = 1 - cosine distance) for a recalled memory to count
MEMWAL_MIN_RELEVANCE=0.2

# --- LLM (Gemini Flash via Google AI Studio, free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- App ---
# Postgres connection string (the /memory mirror lives here, not on disk).
# API server (Render): managed Postgres URL (Neon, Supabase, or Render Postgres).
# Local dev: any Postgres URL, e.g. postgres://mnemo@127.0.0.1:5433/mnemo
DATABASE_URL=
# Secret for signing wallet-auth session cookies and MCP tokens
# (generate: openssl rand -hex 32). Rotating it invalidates all sessions AND
# every issued MCP token — keep it stable across deploys.
SESSION_SECRET=

# --- Split deployment ---
# Frontend (Vercel): absolute URL of the Render API. Leave empty for
# same-origin (single-process local dev).
NEXT_PUBLIC_API_URL=
# Backend (Render): comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=
