# --- Walrus Memory (https://memory.walrus.xyz -> create account + delegate key) ---
# Delegate private key (hex, ed25519). Server-side only, never NEXT_PUBLIC_*.
MEMWAL_PRIVATE_KEY=
# MemWalAccount object ID on Sui (0x...)
MEMWAL_ACCOUNT_ID=
# Relayer URL. Mainnet (default) / staging testnet:
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# mainnet | testnet — controls the "anchored to ..." toast copy
MEMWAL_NETWORK=mainnet
# Minimum relevance (0-1, score = 1 - cosine distance) for a recalled memory to count
MEMWAL_MIN_RELEVANCE=0.2

# --- Walrus blob lifetime (every blob has an end epoch; lapsed = unrecoverable) ---
# Sui GraphQL endpoint used to read the Blob objects the account owner holds
# (public JSON-RPC on fullnodes was sunset in July 2026).
SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql
# Blob struct id on this network (struct ids keep their defining package).
WALRUS_BLOB_TYPE=0xfdc88f7d7cf30afab2f82e8380d11ee8f70efb90e863d1de8616fae1bb09ea77::blob::Blob
# Shared Walrus system object — the current epoch is read from its
# future-accounting ring. Defaults to the mainnet object; override only when
# pointing SUI_GRAPHQL_URL at another network.
# WALRUS_SYSTEM_OBJECT=0x2134d52768ea07e8c43570ef975eb3e4c27a39fa6396bef985b5abc58d03ddd2
# Owner address the relayer transfers Blob objects to. Defaults to the owner
# read off MEMWAL_ACCOUNT_ID on chain; set it only if that lookup ever fails.
# MEMWAL_OWNER_ADDRESS=
# Walrus epoch length in ms (mainnet = 14 days).
# WALRUS_EPOCH_MS=1209600000
# Bearer token for calling GET/POST /api/memory/expiry from a cron
# (generate: openssl rand -hex 32). Leave unset to require a signed-in session.
CRON_SECRET=

# --- LLM (Gemini Flash via Google AI Studio, free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- App ---
# Split API only: port the Render service binds (Render injects PORT; the
# server falls back to 4000). Uncomment for local API runs.
# PORT=4000
# NODE_ENV=development
# Postgres connection string (the /memory mirror lives here, not on disk).
# API server (Render): managed Postgres URL (Neon, Supabase, or Render Postgres).
# Local dev: any Postgres URL, e.g. postgres://mnemo@127.0.0.1:5433/mnemo
DATABASE_URL=
# Secret for signing wallet-auth session cookies and MCP tokens
# (generate: openssl rand -hex 32). Rotating it invalidates all sessions AND
# every issued MCP token — keep it stable across deploys.
SESSION_SECRET=

# --- Split deployment ---
# Frontend (Vercel): absolute URL of the Render API. Leave empty for
# same-origin (single-process local dev).
NEXT_PUBLIC_API_URL=
# Backend (Render): comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=
# Frontend only: canonical site URL used for Open Graph / Twitter metadata
# (defaults to http://localhost:3000 in development).
NEXT_PUBLIC_SITE_URL=
# Frontend only: override the default Sui fullnode RPC endpoint.
NEXT_PUBLIC_SUI_RPC_URL=

# --- zkLogin email sign-in ("Continue with email", Google OIDC) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (type: Web application). Add authorized redirect URIs:
#   local dev:  http://localhost:3000/auth/callback
#   production: https://mnemoai.xyz/auth/callback
# Google rejects any origin that is not registered here with
# redirect_uri_mismatch — every deployed frontend origin needs an entry.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Master key for deriving each user's zkLogin salt (HMAC of iss|aud|sub).
# Generate: openssl rand -hex 32
# !! NEVER rotate this !! — a different key silently maps every zkLogin user
# to a brand-new address, orphaning their memories. Deliberately separate
# from SESSION_SECRET so rotating that (revoking sessions + MCP tokens) is safe.
ZKLOGIN_SALT_SECRET=
